# Apollo Map Studio license signing private key.
# Generate locally with:
#   node tools/license-gen/gen-keys.mjs
#
# Copy this exact value to GitHub Actions secret:
#   APMS_LICENSE_PRIVATE_KEY_BASE64
#
# Do not commit .env. Desktop builds refuse to run without this key so every
# packaged binary embeds the public key derived from the private signing key.
APMS_LICENSE_PRIVATE_KEY_BASE64=
